{
  "name": "bioluz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Assista um repositorio do GitHub se construir do nada em dois minutos",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --noEmit -p api/tsconfig.json",
    "test": "node --experimental-strip-types --test testes/*.test.ts",
    "api": "node --experimental-strip-types testes/servidor.ts",
    "tudo": "node --experimental-strip-types testes/servidor.ts & vite"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.7"
  }
}
